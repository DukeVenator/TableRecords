# Copy to .env and fill in. Never commit .env.

# Discord bot (required for live voice capture)
DISCORD_TOKEN=
# Optional default guild; the dashboard can list guilds/channels without it.
DISCORD_GUILD_ID=
# Scribblespark's nickname in each server (Discord's account name is unchanged).
DISCORD_BOT_NAME=Scribblespark
# Bot activity: playing | listening | watching | competing.
DISCORD_ACTIVITY_TYPE=watching
DISCORD_ACTIVITY_TEXT=every adventure (and slowly destroying this computer)
# Update the activity while recording/testing/processing/listening.
DISCORD_ACTIVITY_DYNAMIC=1

# Local dashboard
PORT=17300
# Optional shared-secret gate for the local dashboard. Leave blank for single-user loopback use.
DASHBOARD_TOKEN=

# Foundry installation data root. If omitted, the server auto-detects
# %LOCALAPPDATA%\FoundryVTT.
# FOUNDRY_DATA_PATH=C:\Users\you\AppData\Local\FoundryVTT
# Optional fixed token for the live Foundry module. Leave blank to let the
# dashboard generate and store one (Setup -> Foundry).
# FOUNDRY_BRIDGE_TOKEN=

# Voice/roll correlation and GM-assist window
# ROLL_CONTEXT_BEFORE_MS=20000
# ROLL_CONTEXT_AFTER_MS=10000
# RECENT_CONTEXT_SECONDS=180

# Capture segmentation and noise gate
# Keep a stream open through pauses shorter than this, so a sentence is not split.
# CAPTURE_SILENCE_MS=2400
# Silence kept after the last voiced frame when trimming the tail.
# CAPTURE_TRIM_PADDING_MS=300
# Clips with less voiced energy than this are kept for review but skipped by STT.
# CAPTURE_MIN_VOICED_MS=200
# 20 ms frame RMS floor used to count a frame as voiced.
# CAPTURE_NOISE_FLOOR_DBFS=-45
# Same-speaker transcript gaps up to this are joined into one timeline event.
# STITCH_GAP_MS=2000

# Phase 2 AI summaries. Disabled by default.
# Provider: ollama, llamacpp, deepseek (cloud, off by default), or local
# (OpenAI-compatible loopback). For llamacpp, point LLM_BASE_URL at llama-server's
# /v1 address and set LLM_MODEL to the server's --alias.
# LLM_ENABLED=0
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=
# LLM_TIMEOUT_MS=60000
# Long briefs are split into portions above this size. 40000 works with small models.
# LLM_MAX_INPUT_CHARS=40000
# Context window per request, from 4096 to 131072. 16384 covers a full portion
# without reserving the model's full maximum. Raise it when using a thinking model.
# LLM_CONTEXT_TOKENS=16384
# Ollama GPU layers. Leave unset for automatic placement; 0 runs on the processor only.
# Lower values move the remaining layers to system memory, which is slower but can
# make a model fit beside Foundry. llama.cpp uses its launch arguments instead.
# LLM_GPU_LAYERS=
# llama.cpp runtime. The dashboard can start llama-server itself.
# LLAMACPP_EXE=llama-server.exe
# LLAMACPP_MODEL_PATH=
# LLAMACPP_PORT=9931
# LLAMACPP_AUTOSTART=0
# These are launch arguments, not OpenAI request fields.
# LLAMACPP_N_CPU_MOE=0
# LLAMACPP_KV_CACHE=f16
# LLAMACPP_FLASH_ATTN=1
# Reasoning effort: off, low, medium, or high. Higher values use more context and time.
# LLM_THINKING_EFFORT=off
# Cloud summaries stay off unless both this and the Setup switch are on.
# LLM_CLOUD_ENABLED=0
# Required only for the DeepSeek provider. The dashboard never stores or returns it.
# DEEPSEEK_API_KEY=

# Whisper (faster-whisper) settings. Used only when STT_ENGINE=whisper.
PYTHON_PATH=.venv\Scripts\python.exe
STT_MODEL=large-v3-turbo
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
STT_MODEL_DIR=models\faster-whisper
STT_LANGUAGE=en
# Optional Whisper fine tuning (all have safe defaults).
# STT_BEAM_SIZE=5
# STT_VAD_FILTER=0
# STT_NO_SPEECH_THRESHOLD=0.6
# STT_LOG_PROB_THRESHOLD=-1
# STT_COMPRESSION_RATIO_THRESHOLD=2.4
# Extra hints shared by both engines.
# STT_PROMPT_EXTRA=
# STT_HOTWORDS_EXTRA=
# STT engine: parakeet (Parrot, default) or faster-whisper (Whisper).
# STT_ENGINE=parakeet
# Parrot (Parakeet) settings.
# NEMO_SPEECH_PATH=C:\temp\nemo-speech\bin\nemo-speech.exe
# PARAKEET_MODEL=models\parakeet\parakeet-tdt-0.6b-v3.q8_0.gguf
# PARAKEET_DEVICE=cuda
# PARAKEET_CONCURRENCY=4
# Optional; defaults to ffmpeg on PATH. Used only for review audio exports.
# FFMPEG_PATH=ffmpeg
# Clips per batch when assembling review audio; larger sessions are stitched
# automatically. 50..2000, default 500.
# REVIEW_AUDIO_BATCH_CLIPS=500
# Dynamically normalize each speaker track (peak target -1 dB, up to +40 dB gain) before the master mix.
# REVIEW_AUDIO_NORMALIZE=1

# Optional: store sessions outside the project
# SESSIONS_DIR=sessions
# DATA_DIR=data
# TIME_ZONE=UTC
# LOG_LEVEL=info

# Optional: fail STT fast when the model is not already cached
# STT_LOCAL_FILES_ONLY=1
# CAPTURE_TEST_MAX_SECONDS=60


